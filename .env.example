# Copy to .env.local and fill in per environment. All are optional — with none
# set, the page runs in smoke-test mode (no pixel, funnel simulated locally).

# Meta Pixel ID. When set, the pixel loads and fires PageView + Lead events.
NEXT_PUBLIC_META_PIXEL_ID=

# Waitlist API endpoint. Receives the signup JSON (email + UTM + tasks +
# eventId), persists it, returns { position, referralCode }, and forwards the
# Meta CAPI "Lead" event server-side using the same eventId for dedup.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Public origin used to build referral links (no trailing slash).
NEXT_PUBLIC_SITE_ORIGIN=https://niro.family
