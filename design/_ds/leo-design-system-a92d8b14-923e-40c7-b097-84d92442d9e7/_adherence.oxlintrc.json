{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|accent|success|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'accent' | 'success' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|icon|iconRight|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, icon, iconRight, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padded|hover|tone|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padded, hover, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inset|brand|outline)$/]",
        "message": "<Card> tone must be one of 'default' | 'inset' | 'brand' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepositCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:city|spots|taken|onReserve|key|ref|className|style|children)$/]",
        "message": "<DepositCTA> doesn't accept that prop. Declared props: city, spots, taken, onReserve."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|dark|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ParentVoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:hinglish|translation|name|relation|key|ref|className|style|children)$/]",
        "message": "<ParentVoiceCard> doesn't accept that prop. Declared props: hinglish, translation, name, relation."
      },
      {
        "selector": "JSXOpeningElement[name.name='PledgeInterstitial'] > JSXAttribute > JSXIdentifier[name!=/^(?:city|onConfirm|onBack|key|ref|className|style|children)$/]",
        "message": "<PledgeInterstitial> doesn't accept that prop. Declared props: city, onConfirm, onBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:onChoose|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: onChoose."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|note|key|ref|className|style|children)$/]",
        "message": "<TaskOption> doesn't accept that prop. Declared props: id, icon, label, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|text|sub|key|ref|className|style|children)$/]",
        "message": "<TrustItem> doesn't accept that prop. Declared props: icon, text, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppQuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|location|time|key|ref|className|style|children)$/]",
        "message": "<WhatsAppQuoteCard> doesn't accept that prop. Declared props: quote, name, location, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='WAMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|type|text|sender|badge|dur|played|time|key|ref|className|style|children)$/]",
        "message": "<WAMessage> doesn't accept that prop. Declared props: from, type, text, sender, badge, dur, played, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='WAMessage'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:you|leo)$/]",
        "message": "<WAMessage> from must be one of 'you' | 'leo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WAMessage'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|voice)$/]",
        "message": "<WAMessage> type must be one of 'text' | 'voice'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
